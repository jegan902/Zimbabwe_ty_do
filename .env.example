# =============================================================================
# Digishop — biến môi trường mẫu
#
# Cách dùng:  cp .env.example .env   rồi điền giá trị thật vào .env
# KHÔNG commit file .env (đã nằm trong .gitignore). File này chỉ chứa tên biến
# và mô tả, tuyệt đối không đặt secret thật ở đây.
# =============================================================================

# -----------------------------------------------------------------------------
# Bắt buộc
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://marketplace:CHANGE_ME@localhost:5432/marketplace?schema=public"
REDIS_URL="redis://localhost:6379"

# Bí mật ký HMAC cho session token, TỐI THIỂU 32 ký tự. Thiếu hoặc ngắn hơn thì
# đăng nhập/khởi tạo session sẽ fail-closed (không chạy được).
# Sinh giá trị: openssl rand -base64 48
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Bảo mật / vận hành
# -----------------------------------------------------------------------------
# true khi chạy sau nginx / Cloudflare / reverse proxy có GHI ĐÈ X-Forwarded-For.
# Để trống hoặc false khi chạy trực tiếp: khi đó app chỉ tin X-Real-IP và
# CF-Connecting-IP, còn lại dùng chung bucket "unknown".
TRUST_PROXY="false"

# Khoá AES-256-GCM (64 ký tự hex) mã hoá credential nhà cung cấp và bản sao
# API key partner trong DB.
# Sinh giá trị: openssl rand -hex 32
# Nếu để trống, key được suy ra từ SESSION_SECRET — không nên dùng ở production.
# Đổi khoá này: credential NCC không giải mã được; API key vẫn xác thực bình thường
# (nhờ apiKeyHash) nhưng chủ key sẽ được cấp key mới khi mở trang API.
ENCRYPTION_KEY=""

# Pepper cộng thêm vào mật khẩu trước khi băm Argon2id (khuyến nghị ở production).
# CẢNH BÁO: đổi giá trị này sẽ làm toàn bộ mật khẩu cũ không còn verify được.
ARGON2_SECRET=""

# URL công khai của site, dùng cho link trong email và callback thanh toán.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email nhận cảnh báo vận hành (số dư NCC thấp, mất kết nối, đơn cần đối soát).
# Nhiều địa chỉ thì cách nhau bởi dấu phẩy. Đây là giá trị mặc định: admin có thể
# nhập danh sách email khác trong /admin/suppliers → "Cài đặt cảnh báo"
# (lưu NotificationSetting.alert_recipients, ưu tiên hơn env).
ADMIN_ALERT_EMAIL=""

# Số phút nhắc lại cảnh báo số dư nhà cung cấp (mặc định 1440 = 1 ngày).
# Đây chỉ là giá trị mặc định: admin chỉnh trực tiếp trong
# /admin/suppliers → "Cài đặt cảnh báo" (lưu bảng NotificationSetting, ưu tiên hơn env).
BALANCE_ALERT_REPEAT_MINUTES="1440"

# -----------------------------------------------------------------------------
# Tài khoản admin do `npm run db:seed` tạo
#
# - Chỉ có tác dụng khi admin CHƯA tồn tại trong DB.
# - Production mà thiếu ADMIN_PASSWORD => seed bỏ qua bước tạo admin.
# - Không đặt fallback mặc định ở production.
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@digishop.com"
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Nhà cung cấp (seed + đồng bộ catalog)
# -----------------------------------------------------------------------------
SUPPLIER_QUANGVINH_BASE_URL=""
SUPPLIER_QUANGVINH_API_KEY=""
SUPPLIER_SHOPFB2027_BASE_URL=""
SUPPLIER_SHOPFB2027_API_KEY=""

# Chu kỳ worker đồng bộ, tính bằng mili giây (mặc định 30000).
SYNC_WORKER_TICK_MS="30000"

# Worker đồng bộ + quét cảnh báo số dư tự chạy cùng process Next (qua
# src/instrumentation.ts), không cần terminal `npm run worker:sync`.
# Đặt false trên các instance phụ (PM2 cluster / nhiều container) để chỉ một
# process giữ lịch chạy. Trên môi trường serverless nên tắt và dùng Cron ngoài.
SYNC_WORKER_ENABLED="true"

# -----------------------------------------------------------------------------
# Thanh toán / nạp tiền
#
# Production BẮT BUỘC có SEPAY_WEBHOOK_SECRET hoặc SEPAY_API_KEY, nếu không
# webhook trả 503 và KHÔNG cộng tiền vào ví (fail-closed).
# Secret dùng để verify chữ ký HMAC-SHA256 của SePay.
# -----------------------------------------------------------------------------
SEPAY_WEBHOOK_SECRET=""
SEPAY_API_KEY=""

# Tài khoản nhận chuyển khoản để sinh mã VietQR.
VIETQR_BANK_BIN="970422"
VIETQR_BANK_ACCOUNT_NUMBER=""
VIETQR_BANK_ACCOUNT_NAME=""

# -----------------------------------------------------------------------------
# SMTP gửi OTP đặt lại mật khẩu và email cảnh báo
#
# Thiếu cấu hình: ở development OTP được in ra console để test, ở production
# chỉ ghi log lỗi — OTP KHÔNG bao giờ được trả về trong response API.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV="development"
